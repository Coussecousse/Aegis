# Copy this file to .env and fill in real values. Never commit .env.

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=aegis
RABBITMQ_USER=CHANGE_ME_USE_VAULT
RABBITMQ_PASSWORD=CHANGE_ME_USE_VAULT
RABBITMQ_QUEUE_EVENTS=aegis.events
RABBITMQ_QUEUE_ALERTS=aegis.alerts

# Ollama (Node 2)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRIAGE_MODEL=tinyllama:1.1b
OLLAMA_REPORT_MODEL=mistral:7b-instruct-q4_0
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_HOST=http://192.168.1.200:11434
SLM_MODEL=tinyllama:1.1b
LLM_MODEL=mistral:7b-instruct-q4_0

# ChromaDB
CHROMADB_HOST=127.0.0.1
CHROMADB_PORT=8000
CHROMADB_COLLECTION_ALERTS=aegis_alerts
CHROMADB_COLLECTION_KNOWLEDGE=aegis_knowledge

# Wazuh
WAZUH_MANAGER_HOST=127.0.0.1
WAZUH_MANAGER_PORT=1514
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_PORT=55000
WAZUH_API_USER=aegis-api
WAZUH_API_PASSWORD=CHANGE_ME_USE_VAULT
WAZUH_AGENT_CPU_CAP_PERCENT=5

# Shuffle SOAR
SHUFFLE_BASE_URL=https://shuffle.local
SHUFFLE_API_KEY=CHANGE_ME_USE_VAULT
SHUFFLE_WORKFLOW_ID=CHANGE_ME_USE_VAULT
SHUFFLE_VERIFY_TLS=true
SHUFFLE_WEBHOOK_URL=CHANGE_ME_USE_VAULT
SHUFFLE_ENCRYPTION_MODIFIER=CHANGE_ME_USE_VAULT
OUTER_HOSTNAME=192.168.1.100

# Teams Webhook
TEAMS_WEBHOOK_URL=CHANGE_ME_USE_VAULT

# GLPI
GLPI_BASE_URL=https://glpi.local/apirest.php
GLPI_APP_TOKEN=CHANGE_ME_USE_VAULT
GLPI_USER_TOKEN=CHANGE_ME_USE_VAULT

# HashiCorp Vault
VAULT_ADDR=https://vault.local:8200
VAULT_TOKEN=CHANGE_ME_USE_VAULT
VAULT_NAMESPACE=CHANGE_ME_USE_VAULT
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=aegis

# Prometheus
PROMETHEUS_HOST=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_HOST=127.0.0.1
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=aegis-admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_USE_VAULT
