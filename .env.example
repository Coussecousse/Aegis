# AEGIS v0.2.0 environment configuration template
# Copy to .env and replace placeholder values before running the stack.
# SECURITY: Never commit a real .env with secrets.

# ============================================================================
# RabbitMQ configuration
# ============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=aegis
RABBITMQ_PASSWORD=CHANGE_ME_USE_VAULT
RABBITMQ_VHOST=aegis
RABBITMQ_QUEUE=aegis.triage

# ============================================================================
# Ollama configuration (SLM + LLM inference)
# ============================================================================
# The Raspberry Pi AI node is reached through WireGuard at 10.0.0.1.
# Ollama on the Pi must listen on 0.0.0.0:11434 for this URL to work.
OLLAMA_BASE_URL=http://10.0.0.1:11434
SLM_MODEL=tinyllama-aegis
LLM_MODEL=mistral-aegis
SLM_TIMEOUT=10
LLM_TIMEOUT=45
SUSPICION_THRESHOLD=0.5

# ============================================================================
# ChromaDB configuration
# ============================================================================
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_COLLECTION=aegis_assets

# ============================================================================
# Wazuh stack configuration
# ============================================================================
WAZUH_INDEXER_PASSWORD=CHANGE_ME_USE_VAULT
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_USE_VAULT
WAZUH_DASHBOARD_PASSWORD=CHANGE_ME_USE_VAULT
WAZUH_AGENT_CPU_CAP_PERCENT=5
WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
WAZUH_MIN_LEVEL=7
WAZUH_POLL_INTERVAL=1.0

# ============================================================================
# Shuffle SOAR configuration
# ============================================================================
SHUFFLE_WEBHOOK_URL=http://shuffle-backend:5001/api/v1/hooks/HOOK_ID_HERE
SHUFFLE_ENCRYPTION_MODIFIER=CHANGE_ME_USE_VAULT
OUTER_HOSTNAME=localhost:3001

# ============================================================================
# Logging configuration
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# GLPI
# ============================================================================
GLPI_BASE_URL=https://glpi.local/apirest.php
GLPI_APP_TOKEN=CHANGE_ME_USE_VAULT
GLPI_USER_TOKEN=CHANGE_ME_USE_VAULT

# ============================================================================
# HashiCorp Vault
# ============================================================================
VAULT_ADDR=https://vault.local:8200
VAULT_TOKEN=CHANGE_ME_USE_VAULT
VAULT_NAMESPACE=CHANGE_ME_USE_VAULT
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=aegis
VAULT_TIMEOUT=5.0

# ============================================================================
# Prometheus
# ============================================================================
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# ============================================================================
# Grafana
# ============================================================================
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=aegis-admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_USE_VAULT
