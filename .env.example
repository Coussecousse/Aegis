# AEGIS v0.2.0 environment configuration template
# Copy to .env and replace placeholder values before running the stack.
# SECURITY: Never commit a real .env with secrets.

# ============================================================================
# RabbitMQ configuration
# ============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=aegis
RABBITMQ_PASSWORD=CHANGE_ME_USE_VAULT
RABBITMQ_VHOST=aegis
RABBITMQ_QUEUE=aegis.triage
# Reports queue consumed by the analysis stage (LLM + risk + report + SOAR) —
# decoupled from the triage queue so a slow LLM never blocks fast SLM triage.
RABBITMQ_REPORTS_QUEUE=aegis.reports
# Exchange all alerts route through, and the identity-sync queue (UEBA auto-update).
RABBITMQ_EXCHANGE=aegis.alerts
RABBITMQ_IDENTITY_QUEUE=identity.sync

# ============================================================================
# Ollama configuration (SLM + LLM inference)
# ============================================================================
# The Raspberry Pi AI node is reached through WireGuard at 10.0.0.1.
# AEGIS runs TWO independent Ollama instances on the Pi, each pinned to its
# own CPU cores so a multi-minute LLM analysis never blocks SLM triage:
#   - SLM instance: port 11434, 1 CPU core
#   - LLM instance: port 11435, remaining CPU cores
# See docs/raspberrypi-ollama-setup.md for the systemd setup.
# CPU-only inference on the Pi runs at roughly ~2 sec/token — these timeouts
# reflect that measured throughput rather than cloud-scale expectations.
OLLAMA_SLM_BASE_URL=http://10.0.0.1:11434
OLLAMA_LLM_BASE_URL=http://10.0.0.1:11435
# SLM: Qwen 2.5 1.5B (Apache 2.0) — fast triage, structured JSON, edge-optimised
# Create on Pi: ollama create qwen25-aegis -f docs/modelfiles/Modelfile.slm-qwen25
SLM_MODEL=qwen25-aegis
# LLM: detailed threat analysis and report generation — Mistral 7B Q4 (Apache 2.0).
#   ollama create mistral-aegis -f docs/modelfiles/Modelfile.llm-mistral
LLM_MODEL=mistral-aegis
# Ollama structured outputs for the LLM: constrains decoding to the LlmResponse
# JSON Schema so the model cannot return a partial/degenerate object. Requires
# Ollama >= 0.5 on the inference node — keep false until you confirm the version
# (`ollama --version` on the Pi), else an older Ollama rejects the format payload.
LLM_USE_SCHEMA=false
# Pi 16 GB holds both models in RAM simultaneously (no swap). Timeouts reflect
# measured ARM64 CPU-only throughput: ~8-18s SLM, ~5-10 min LLM.
SLM_TIMEOUT=90
LLM_TIMEOUT=600
SUSPICION_THRESHOLD=0.5
# UEBA false-positive gate: an alert on a calm, profiled, non-critical asset with a
# low-severity rule is dropped only when SLM confidence is BELOW this ceiling. A
# confident SLM suspicion (>= ceiling) always escalates — a quiet asset baseline must
# not silence a confirmed attack (e.g. a level-7 SQLi).
FP_GATE_CONFIDENCE_CEILING=0.6

# ============================================================================
# ChromaDB configuration
# ============================================================================
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_COLLECTION=aegis_assets

# ============================================================================
# Wazuh stack configuration
# ============================================================================
WAZUH_INDEXER_PASSWORD=CHANGE_ME_USE_VAULT
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_USE_VAULT
WAZUH_DASHBOARD_PASSWORD=CHANGE_ME_USE_VAULT
WAZUH_AGENT_CPU_CAP_PERCENT=5
WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
WAZUH_MIN_LEVEL=7
# Comma-separated Wazuh rule ids to drop as known noise before they reach the
# pipeline (e.g. infra-host self-monitoring: 533 = netstat port change). Filter
# by RULE, not by agent: a single agent here covers both the AEGIS host and the
# monitored targets, so excluding the agent would blind real detections.
WAZUH_EXCLUDED_RULES=
WAZUH_POLL_INTERVAL=1.0

# ============================================================================
# Shuffle SOAR configuration
# ============================================================================
SHUFFLE_WEBHOOK_URL=http://shuffle-backend:5001/api/v1/hooks/HOOK_ID_HERE
SHUFFLE_ENCRYPTION_MODIFIER=CHANGE_ME_USE_VAULT
OUTER_HOSTNAME=localhost:3001
# Optional: human pre-approved SOAR response policies (rule_id → action), JSON file.
# See docker/node1/response-policies.example.json. Unset = no automatic action.
RESPONSE_POLICY_FILE=
# Orborus execution engine — retrieve after first Shuffle startup:
#   SHUFFLE_ORG_ID  : grep "organization" docker logs shuffle-backend | tail -1
#   SHUFFLE_API_KEY : Shuffle UI → top-right profile icon → API key
SHUFFLE_ORG_ID=CHANGE_ME_AFTER_FIRST_SHUFFLE_STARTUP
SHUFFLE_API_KEY=CHANGE_ME_USE_VAULT

# ============================================================================
# Logging configuration
# ============================================================================
LOG_LEVEL=INFO
# Optional: write logs to this file in addition to stdout (unset = stdout only).
LOG_FILE=

# ============================================================================
# GLPI
# ============================================================================
GLPI_BASE_URL=https://glpi.local/apirest.php
GLPI_APP_TOKEN=CHANGE_ME_USE_VAULT
GLPI_USER_TOKEN=CHANGE_ME_USE_VAULT

# ============================================================================
# HashiCorp Vault
# ============================================================================
VAULT_ADDR=https://vault.local:8200
VAULT_TOKEN=CHANGE_ME_USE_VAULT
VAULT_NAMESPACE=CHANGE_ME_USE_VAULT
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=aegis
VAULT_TIMEOUT=5.0

# ============================================================================
# Prometheus
# ============================================================================
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# ============================================================================
# Grafana
# ============================================================================
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=aegis-admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_USE_VAULT

# ============================================================================
# LDAP / Active Directory identity connector (optional — leave blank to disable)
# Set LDAP_USE_SSL=true and LDAP_PORT=636 for production LDAPS.
# For plain LDAP (POC/dev), use LDAP_USE_SSL=false and LDAP_PORT=389.
# ============================================================================
LDAP_HOST=
LDAP_PORT=0
LDAP_USE_SSL=false
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=CHANGE_ME_USE_VAULT
LDAP_TIER0_GROUP_DN=CN=Domain Admins,CN=Users,DC=example,DC=local
LDAP_TIMEOUT=5.0
