# AEGIS v0.2.0 Environment Configuration Template
# Copy to .env and fill in your values
# SECURITY: Never commit .env to version control
# Use .gitignore to exclude: .env, .env.*.local

# ============================================================================
# RabbitMQ Configuration (Wazuh alert ingestion)
# ============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aegis
RABBITMQ_PASSWORD=changeme
RABBITMQ_QUEUE=aegis.wazuh.alerts

# ============================================================================
# Ollama Configuration (SLM + LLM inference)
#
# CRITICAL for WireGuard setup (Raspberry Pi access):
# The Raspberry Pi AI node is accessed via WireGuard tunnel (IP 10.0.0.1).
# Ollama MUST listen on 0.0.0.0:11434 to accept connections over WireGuard.
#
# On Raspberry Pi, configure:
#   sudo systemctl edit ollama
#   Add: Environment="OLLAMA_HOST=0.0.0.0:11434"
#   sudo systemctl restart ollama
#
# Verify:
#   curl http://10.0.0.1:11434/api/tags
#
# See docs/raspberrypi-ollama-setup.md for complete setup guide.
# ============================================================================
OLLAMA_BASE_URL=http://10.0.0.1:11434
SLM_MODEL=tinyllama-aegis
LLM_MODEL=mistral-aegis
SLM_TIMEOUT=10
LLM_TIMEOUT=45
SUSPICION_THRESHOLD=0.5

# ============================================================================
# ChromaDB Configuration (Asset context + UEBA + RAG)
# ============================================================================
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=aegis_assets

# ============================================================================
# Shuffle SOAR Configuration (Webhook delivery for final reports)
# ============================================================================
# Full webhook URL including hook ID (provided by Shuffle admin)
SHUFFLE_WEBHOOK_URL=http://shuffle:3001/api/v1/hooks/HOOK_ID_HERE

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: verbose logging (development only)
# INFO: standard operational logging (recommended)
# WARNING: warnings and errors only

# GLPI
GLPI_BASE_URL=https://glpi.local/apirest.php
GLPI_APP_TOKEN=CHANGE_ME_USE_VAULT
GLPI_USER_TOKEN=CHANGE_ME_USE_VAULT

# HashiCorp Vault
VAULT_ADDR=https://vault.local:8200
VAULT_TOKEN=CHANGE_ME_USE_VAULT
VAULT_NAMESPACE=CHANGE_ME_USE_VAULT
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=aegis

# Prometheus
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=aegis-admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_USE_VAULT
